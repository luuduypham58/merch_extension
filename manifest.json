{
  "manifest_version": 3,
  "name": "Merch Flow v0.9.34",
  "version": "0.9.34",
  "description": "Merch Flow v0.9.34: strict tab ownership, manual product handoff, IndexedDB Vault, and runtime hardening.",
  "action": {
    "default_title": "Mở Merch Flow ở Side Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://merch.amazon.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.blob.core.windows.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://merch.amazon.com/*"
      ],
      "js": [
        "merch-flow-core.js",
        "merch-content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "merch-flow-core.js",
        "chatgpt-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
